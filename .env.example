# Keycloak uses :8080 in the nails local stack — keep the edge API on :8082.
HTTP_ADDR=:8082
CORE_BASE_URL=http://localhost:8083
DEFAULT_TENANT_SLUG=nails-demo
UPLOAD_DIR=./uploads

# Keycloak customers
KEYCLOAK_ISSUER=http://localhost:8080/realms/nails
KEYCLOAK_ISSUER_ALIASES=
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/nails/protocol/openid-connect/certs
KEYCLOAK_MOBILE_CLIENT_ID=nails-mobile
KEYCLOAK_BACKEND_CLIENT_ID=nails-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me-nails-backend-secret

# Keycloak staff
KEYCLOAK_STAFF_ISSUER=http://localhost:8080/realms/nails-staff
KEYCLOAK_STAFF_ISSUER_ALIASES=
KEYCLOAK_STAFF_JWKS_URI=http://localhost:8080/realms/nails-staff/protocol/openid-connect/certs
KEYCLOAK_STAFF_WEB_CLIENT_ID=nails-staff-web

# Tenant settings are authoritative for these flags; defaults help bootstrap.
FEATURE_DISENO_IA=true
AI_DISENO_DAILY_LIMIT=3
AI_DISENO_MAX_TOTAL=5
POLLINATIONS_API_KEY=
